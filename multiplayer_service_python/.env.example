# Host-side binding and published TCP port. Container always listens on 8001.
AOE2_MP_BIND_IP=0.0.0.0
AOE2_MP_PUBLIC_PORT=8001

# One process owns all rooms and the matching queue.
AOE2_MP_MAX_CONNECTIONS=128
AOE2_MP_MAX_QUEUE=128
AOE2_MP_MAX_SPECTATORS_PER_MATCH=16
AOE2_MP_MAX_LISTED_MATCHES=64
AOE2_MP_KEYFRAME_REQUEST_INTERVAL=1
AOE2_MP_KEYFRAME_TIMEOUT=10
AOE2_MP_IDLE_TIMEOUT=30
AOE2_MP_QUEUE_TIMEOUT=120
AOE2_MP_READY_TIMEOUT=30
AOE2_MP_MATCH_TIMEOUT=10800

# Compose persists standings in its leaderboard_data volume at /data.
# Native Python only: optionally set AOE2_MP_LEADERBOARD_DB to an SQLite path.
